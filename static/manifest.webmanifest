{
	"name": "Tarkeebi",
	"short_name": "Tarkeebi",
	"description": "Your personal recipe box.",
	"start_url": "/app",
	"scope": "/",
	"display": "standalone",
	"orientation": "portrait-primary",
	"background_color": "#f9f5ed",
	"theme_color": "#9a3d06",
	"categories": ["food", "lifestyle", "productivity"],
	"shortcuts": [
		{
			"name": "New recipe",
			"short_name": "New",
			"url": "/app/recipes/new"
		},
		{
			"name": "Favorites",
			"short_name": "Favorites",
			"url": "/app?filter=favorites"
		}
	],
	"icons": [
		{
			"src": "/icons/icon-192.png",
